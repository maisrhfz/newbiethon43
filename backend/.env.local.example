# Copy this file to .env.local and fill in a real key to switch from the
# built-in mock estimator to live ODsay Lab transit routing.
#
# Get a free key at https://lab.odsay.com (register with a Korean phone
# number). Free tier has a daily call cap, so keep the mock as a fallback
# even after you add a key.
ODSAY_API_KEY=

# Lock CORS down to your deployed frontend's exact origin before judging,
# e.g. https://wont-be-late-frontend.vercel.app. Defaults to "*" (any
# origin) if unset, which is fine while you're both still developing.
ALLOWED_ORIGIN=
