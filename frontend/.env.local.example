# URL of the deployed backend Vercel project (no trailing slash), e.g.
# https://wont-be-late-backend.vercel.app
#
# Leave blank only if you've set up a Vercel rewrite/proxy so /api/* on this
# project's own domain forwards to the backend — otherwise the frontend
# needs the backend's real URL to call it cross-origin.
NEXT_PUBLIC_API_BASE_URL=
